WORKDAY_URL=https://www.myworkday.com/your_university/d/home.htmld
WORKDAY_EMAIL=your_email@example.edu
WORKDAY_PASSWORD=your_workday_password
SENDER_EMAIL=your_bot_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
RECEIVER_EMAIL=your_personal_email@gmail.com
JOB_ALERT_EMAILS=your_personal_email@gmail.com,friend_email@gmail.com
DISCORD_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here
OBSCURA_PATH=
ERROR_THRESHOLD=3
AI_API_ENDPOINT=http://localhost:8080/ask
AI_PROMPT="Analyze the following job description and extract the most critical information needed to decide whether to apply. Keep the extracted text extremely concise. Output the result strictly as a valid JSON object.\n\nDo not include any conversational text, markdown formatting (like ```json), or explanations.\n\nThe JSON object must contain exactly these five keys: \"availability\" (expected schedule/hours), \"pay_rate\" (compensation or 'Not specified'), \"responsibilities\" (core duties), \"eligibility\" (mandatory requirements), and \"NOTE\" (other critical details or 'None').\n\nExample format:\n{\n\"availability\": \"6-20 hours/week, flexible scheduling.\",\n\"pay_rate\": \"$17.00 - $19.00/hr\",\n\"responsibilities\": \"Monitor the CTL lab, assist students with equipment.\",\n\"eligibility\": \"Must be in 2nd year or later.\",\n\"NOTE\": \"Mandatory in-person training on Sept 2-3.\"\n}"